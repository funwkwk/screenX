<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\screenX.ico</ApplicationIcon>
    <AssemblyName>screenX</AssemblyName>
    <RootNamespace>ScreenX</RootNamespace>
    <Product>screenX</Product>
    <Version>1.0.0</Version>
    <Authors>Irfan</Authors>
    <Copyright>Copyright (c) 2026 Irfan</Copyright>
    <Description>screenX - open-source screen capture, recording, colour picker, OCR and markup tool.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/funwkwk/screenX</RepositoryUrl>
    <NoWarn>$(NoWarn);CA1416;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\screenX.ico" LogicalName="screenX.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

</Project>
