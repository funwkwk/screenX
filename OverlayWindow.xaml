<Window x:Class="ScreenX.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="screenX" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="Black" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FocusVisualStyle="{x:Null}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="BarBg" Color="#F22C2C2C"/>
        <SolidColorBrush x:Key="BarBorder" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="Hover" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="Pressed" Color="#0FFFFFFF"/>

        <!-- generic flat icon button (Button / ToggleButton / RadioButton) -->
        <Style x:Key="Flat" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2"
                                    BorderBrush="Transparent" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Under" Height="3" Width="16" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- toggle with a subtle filled background + accent underline when checked (camera / video / tools) -->
        <Style x:Key="Seg" TargetType="ToggleButton" BasedOn="{StaticResource Flat}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2"
                                    BorderBrush="Transparent" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Under" Height="3" Width="16" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#14FFFFFF"/>
                                <Setter TargetName="Under" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- markup tool: checked = accent outline box (like the reference pen) -->
        <Style x:Key="Tool" TargetType="ToggleButton" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2"
                                    BorderBrush="Transparent" BorderThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Chev" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="8"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,4" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="Chev" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shape picker: accent outline box when checked, no chevron -->
        <Style x:Key="Pick" TargetType="ToggleButton" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2"
                                    BorderBrush="Transparent" BorderThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- filled accent toggle (markup-after-capture) -->
        <Style x:Key="AccentToggle" TargetType="ToggleButton" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3"/>
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#0B2532"/>
                            </Trigger>
                            <!-- declared last so it wins over IsChecked: grey, inactive look in video mode -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#6E6E6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Fill" Value="#2EFFFFFF"/>
        </Style>

        <!-- menu item row inside flyouts -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,9" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Flyout" TargetType="Border">
            <Setter Property="Background" Value="#FA2C2C2C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BarBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- accent slider (Size) -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="22" Height="22">
                            <Ellipse Fill="#454545" Stroke="#30FFFFFF" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource Accent}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="14"/>
                                <Setter TargetName="Dot" Property="Height" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="24">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackFill}" Background="{StaticResource Accent}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackFill}" Background="#9A9A9A" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- vector icons -->
        <Geometry x:Key="IcoEyedropper">M13.2,3.6 C14.2,2.6 15.6,2.6 16.5,3.5 C17.4,4.4 17.4,5.8 16.4,6.8 L14.6,8.6 L11.4,5.4 Z M12.3,6.3 L13.7,7.7 L6.6,14.8 L4.2,15.8 L5.2,13.4 Z M3.9,16.1 L3.4,16.6</Geometry>
        <Geometry x:Key="IcoTextScan">M3,7 V4.5 C3,3.7 3.7,3 4.5,3 H7 M13,3 H15.5 C16.3,3 17,3.7 17,4.5 V7 M17,13 V15.5 C17,16.3 16.3,17 15.5,17 H13 M7,17 H4.5 C3.7,17 3,16.3 3,15.5 V13 M7,7.5 H13 M7,10 H13 M7,12.5 H11</Geometry>
        <Geometry x:Key="IcoScanTarget">M3,7 V4.5 C3,3.7 3.7,3 4.5,3 H7 M13,3 H15.5 C16.3,3 17,3.7 17,4.5 V7 M17,13 V15.5 C17,16.3 16.3,17 15.5,17 H13 M7,17 H4.5 C3.7,17 3,16.3 3,15.5 V13 M10,7.6 A2.4,2.4 0 1 1 9.99,7.6 Z</Geometry>
        <Geometry x:Key="IcoShapes">M3,8.5 H10.5 V16 H3 Z M14,2.8 A4.2,4.2 0 1 1 13.99,2.8 Z</Geometry>
        <Geometry x:Key="IcoRectSnip">M4.5,4 H15.5 C16.3,4 17,4.7 17,5.5 V10.5 M10.5,16 H4.5 C3.7,16 3,15.3 3,14.5 V5.5 C3,4.7 3.7,4 4.5,4 M15,13 V18 M12.5,15.5 H17.5</Geometry>
        <Geometry x:Key="IcoMarkup">M14.5,8.5 V4.5 C14.5,3.7 13.8,3 13,3 H4.5 C3.7,3 3,3.7 3,4.5 V13 C3,13.8 3.7,14.5 4.5,14.5 H8 M3.5,12 L7,8.5 L9.5,11 M10.5,5.5 A1.2,1.2 0 1 1 10.49,5.5 Z M10.5,17 L11,14.6 L16,9.6 C16.6,9 17.4,9 17.9,9.6 C18.5,10.1 18.5,10.9 17.9,11.5 L12.9,16.5 Z</Geometry>
    </Window.Resources>

    <Grid x:Name="Root">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <Canvas x:Name="Surface" Background="Transparent" Cursor="Cross" ClipToBounds="True"
                MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                MouseMove="Surface_MouseMove"
                MouseLeftButtonUp="Surface_MouseLeftButtonUp"
                MouseRightButtonUp="Surface_MouseRightButtonUp">
            <Path x:Name="Dim" Fill="#8C000000" IsHitTestVisible="False"/>

            <!-- in-place markup ink -->
            <InkCanvas x:Name="Ink" Background="Transparent" Visibility="Collapsed" Cursor="Pen"/>

            <Path x:Name="SelOutline" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False"/>

            <Border x:Name="SizeLabel" Background="#E6202020" CornerRadius="4" Padding="6,2"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
            </Border>

            <Border x:Name="Magnifier" Background="#F0202020" CornerRadius="8" Padding="6"
                    BorderBrush="#55FFFFFF" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <Grid Width="130" Height="130" ClipToBounds="True">
                        <Image x:Name="MagImage" Width="130" Height="130" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Rectangle Width="12" Height="12" Stroke="Black" StrokeThickness="1"/>
                        <Rectangle Width="10" Height="10" Stroke="White" StrokeThickness="1"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border x:Name="MagSwatch" Width="18" Height="18" CornerRadius="4"
                                BorderBrush="#88FFFFFF" BorderThickness="1"/>
                        <TextBlock x:Name="MagText" Foreground="White" FontFamily="Consolas" FontSize="13"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================= markup bar (below the selection) ======================= -->
            <Border x:Name="MarkupBar" Background="{StaticResource BarBg}" BorderBrush="{StaticResource BarBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="6" Visibility="Collapsed" Cursor="Arrow"
                    MouseLeftButtonDown="Bar_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <!-- split Capture button -->
                    <Border CornerRadius="5" Background="{StaticResource Accent}" Margin="2,2,6,2" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnCapture" Click="Capture_Click" ToolTip="Capture (Ctrl+Enter)" Cursor="Arrow" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="5,0,0,5" Padding="16,0,14,0">
                                            <TextBlock Text="Capture" Foreground="#0B2532" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnCaptureMenu" Click="CaptureMenu_Click" ToolTip="Opsi capture" Cursor="Arrow" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="0,5,5,0" Padding="12,0">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="#0B2532" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Flat}" Content="&#xE72D;" ToolTip="Bagikan" Click="Share_Click"/>
                    <Button Style="{StaticResource Flat}" ToolTip="Cari gambar dengan Google Lens" Click="Search_Click">
                        <Path Data="{StaticResource IcoScanTarget}" Stroke="White" StrokeThickness="1.4" Width="20" Height="20"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Rectangle Style="{StaticResource Sep}"/>

                    <ToggleButton x:Name="ToolPen" Style="{StaticResource Tool}" ToolTip="Pulpen" Click="Tool_Click">
                        <Canvas Width="20" Height="20" Margin="0,0,0,6">
                            <Path Data="M6,2.5 H14 L13,10 H7 Z" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                            <Path x:Name="PenTip" Data="M7,10 H13 L10,17 Z" Fill="#E81123" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        </Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolHighlighter" Style="{StaticResource Tool}" ToolTip="Highlighter" Click="Tool_Click">
                        <Canvas Width="20" Height="20" Margin="0,0,0,6">
                            <Path x:Name="HlCap" Data="M5.5,2.5 H14.5 V7.5 H5.5 Z" Fill="#FCE100" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                            <Path Data="M5.5,7.5 H14.5 L12.5,12 V16 L7.5,17.5 V12 Z" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        </Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolEraser" Style="{StaticResource Tool}" ToolTip="Penghapus" Click="Tool_Click"
                                  Content="&#xE75C;" Padding="0,0,0,6"/>
                    <ToggleButton x:Name="ToolShapes" Style="{StaticResource Tool}" ToolTip="Bentuk" Click="Tool_Click">
                        <Path Data="{StaticResource IcoShapes}" Stroke="White" StrokeThickness="1.4" Width="20" Height="20" Margin="0,0,0,6"/>
                    </ToggleButton>
                    <Rectangle Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnUndo" Style="{StaticResource Flat}" Content="&#xE7A7;" ToolTip="Urungkan (Ctrl+Z)" Click="Undo_Click"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource Flat}" Content="&#xE7A6;" ToolTip="Ulangi (Ctrl+Y)" Click="Redo_Click"/>
                    <Rectangle Style="{StaticResource Sep}"/>
                    <Button Style="{StaticResource Flat}" Content="&#xE74D;" ToolTip="Buang snip (batal)" Click="Discard_Click"/>
                </StackPanel>
            </Border>

            <!-- Capture menu -->
            <Border x:Name="CaptureMenu" Style="{StaticResource Flyout}" Width="260" Cursor="Arrow" MouseLeftButtonDown="Bar_MouseDown">
                <StackPanel>
                    <Button Style="{StaticResource MenuRow}" Click="Capture_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Enter" Foreground="#C8C8C8" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Capture" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="SaveTo_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+S" Foreground="#C8C8C8" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Save to" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="CopyOnly_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+C" Foreground="#C8C8C8" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy only" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Colour + size flyout for pen / highlighter -->
            <Border x:Name="InkFlyout" Style="{StaticResource Flyout}" Padding="16,12,16,16" Cursor="Arrow" MouseLeftButtonDown="Bar_MouseDown">
                <StackPanel Width="276">
                    <TextBlock Text="Colours" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <UniformGrid x:Name="ColourGrid" Columns="6"/>
                    <TextBlock Text="Size" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <Path x:Name="SizePreview" Height="44" Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M14,32 C70,4 120,10 150,22 C185,36 225,40 262,12"/>
                    <Slider x:Name="SizeSlider" Minimum="1" Maximum="24" Value="4" Margin="0,8,0,0"
                            IsMoveToPointEnabled="True" ValueChanged="SizeSlider_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- Eraser flyout -->
            <Border x:Name="EraserFlyout" Style="{StaticResource Flyout}" Cursor="Arrow" MouseLeftButtonDown="Bar_MouseDown">
                <Button Style="{StaticResource MenuRow}" Click="EraseAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Erase all mark-ups" FontSize="14" Margin="14,0,4,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Shapes bar: emoji | rectangle ellipse line arrow | Fill Outline -->
            <Border x:Name="ShapesFlyout" Style="{StaticResource Flyout}" Padding="6" Cursor="Arrow" MouseLeftButtonDown="Bar_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="BtnEmoji" Style="{StaticResource Seg}" ToolTip="Emoji" Click="Emoji_Click"
                                  Content="&#xE76E;" FontSize="20" Width="48" Height="44"/>
                    <Rectangle Style="{StaticResource Sep}"/>
                    <ToggleButton x:Name="ShapeRect" Style="{StaticResource Pick}" ToolTip="Rectangle" Click="ShapeKind_Click">
                        <Path Data="M3.5,4.5 H16.5 V15.5 H3.5 Z" Stroke="White" StrokeThickness="1.6" Width="20" Height="20"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ShapeEllipse" Style="{StaticResource Pick}" ToolTip="Ellipse" Click="ShapeKind_Click">
                        <Path Data="M10,3.5 A6.5,6.5 0 1 1 9.99,3.5 Z" Stroke="White" StrokeThickness="1.6" Width="20" Height="20"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ShapeLine" Style="{StaticResource Pick}" ToolTip="Line" Click="ShapeKind_Click">
                        <Path Data="M4,4 L16,16" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ShapeArrow" Style="{StaticResource Pick}" ToolTip="Arrow" Click="ShapeKind_Click">
                        <Path Data="M16,16 L4.5,4.5 M4.5,11 V4.5 H11" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20"/>
                    </ToggleButton>
                    <Rectangle Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnFill" Style="{StaticResource Flat}" Width="Auto" Padding="10,0" ToolTip="Fill" Click="Fill_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Grid Width="22" Height="22">
                                <Ellipse x:Name="FillSwatch" Width="20" Height="20" Stroke="#C8C8C8" StrokeThickness="1.5"/>
                                <Line x:Name="FillNone" X1="5" Y1="17" X2="17" Y2="5" Stroke="#C8C8C8" StrokeThickness="1.5"/>
                            </Grid>
                            <TextBlock Text="Fill" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" Margin="10,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOutline" Style="{StaticResource Flat}" Width="Auto" ToolTip="Outline" Click="Outline_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Grid Width="22" Height="22">
                                <Ellipse x:Name="OutlineRing" Width="20" Height="20" StrokeThickness="4" Stroke="#E81123"/>
                                <Ellipse Width="6" Height="6" Fill="#E81123" x:Name="OutlineDot"/>
                            </Grid>
                            <TextBlock Text="Outline" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" Margin="10,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Emoji picker -->
            <Border x:Name="EmojiFlyout" Style="{StaticResource Flyout}" Padding="10" Cursor="Arrow" MouseLeftButtonDown="Bar_MouseDown">
                <UniformGrid x:Name="EmojiGrid" Columns="6"/>
            </Border>

            <!-- Fill / Outline colour palette -->
            <Border x:Name="PaletteFlyout" Style="{StaticResource Flyout}" Padding="16,12,16,16" Cursor="Arrow" MouseLeftButtonDown="Bar_MouseDown">
                <StackPanel Width="276">
                    <TextBlock x:Name="PaletteTitle" Text="Fill" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Button x:Name="BtnNoFill" Style="{StaticResource MenuRow}" Click="NoFill_Click" Margin="-8,0,-8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE733;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="No fill" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <UniformGrid x:Name="PaletteGrid" Columns="6"/>
                    <StackPanel x:Name="OutlineSizePanel">
                        <TextBlock Text="Size" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <Slider x:Name="OutlineSlider" Minimum="1" Maximum="24" Value="4" IsMoveToPointEnabled="True" ValueChanged="OutlineSlider_ValueChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ======================= top capture toolbar ======================= -->
        <StackPanel x:Name="TopPanel" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border x:Name="Toolbar" Background="{StaticResource BarBg}" CornerRadius="8" Padding="6"
                    BorderBrush="{StaticResource BarBorder}" BorderThickness="1" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <!-- photo / video segment -->
                    <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="BtnPhoto" Style="{StaticResource Seg}" Content="&#xE722;" ToolTip="Snip (foto)" Click="Photo_Click"/>
                            <ToggleButton x:Name="BtnVideo" Style="{StaticResource Seg}" Content="&#xE714;" ToolTip="Rekam layar (video)" Click="Video_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- snip shape dropdown -->
                    <Button x:Name="BtnShape" Style="{StaticResource Flat}" Width="62" ToolTip="Mode snip" Click="ShapeMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl x:Name="ShapeIcon" Width="20" Height="20"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" Margin="6,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ToggleButton x:Name="BtnMarkup" Style="{StaticResource AccentToggle}" ToolTip="Markup langsung setelah snip" Click="Markup_Click">
                        <Path Data="{StaticResource IcoMarkup}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.4" Width="21" Height="20" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </ToggleButton>

                    <Rectangle Style="{StaticResource Sep}"/>

                    <ToggleButton x:Name="BtnColor" Style="{StaticResource Seg}" ToolTip="Color picker" Click="Color_Click">
                        <Path Data="{StaticResource IcoEyedropper}" Stroke="White" StrokeThickness="1.4" Width="20" Height="20"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnText" Style="{StaticResource Seg}" ToolTip="Text extractor" Click="Text_Click">
                        <Path Data="{StaticResource IcoTextScan}" Stroke="White" StrokeThickness="1.4" Width="20" Height="20"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </ToggleButton>

                    <Rectangle Style="{StaticResource Sep}"/>
                    <Button Style="{StaticResource Flat}" Content="&#xE711;" FontSize="16" ToolTip="Tutup (Esc)" Click="Close_Click"/>
                </StackPanel>
            </Border>

            <!-- snip shape menu (drops below the toolbar) -->
            <Border x:Name="ShapeMenu" Style="{StaticResource Flyout}" Width="220" HorizontalAlignment="Left" Margin="0,6,0,0">
                <StackPanel x:Name="ShapeMenuList"/>
            </Border>

            <Border x:Name="HintBox" Background="#D9202020" CornerRadius="6" Padding="10,4" Margin="0,8,0,0"
                    HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="Hint" Foreground="#E6FFFFFF" FontSize="12"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
