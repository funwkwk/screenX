<Window x:Class="ScreenX.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="screenX" Width="1200" Height="800" MinWidth="960" MinHeight="420"
        Background="#202020" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="Hover" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="Pressed" Color="#0FFFFFFF"/>

        <Style x:Key="Flat" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2,0"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- photo / video segment -->
        <Style x:Key="Seg" TargetType="ToggleButton" BasedOn="{StaticResource Flat}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2"
                                    BorderBrush="Transparent" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Under" Height="3" Width="14" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#14FFFFFF"/>
                                <Setter TargetName="Under" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- markup tool: checked = accent outline box with a chevron -->
        <Style x:Key="Tool" TargetType="ToggleButton" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2,0"
                                    BorderBrush="Transparent" BorderThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Chev" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="7"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,1" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="Chev" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shape kind picker -->
        <Style x:Key="Pick" TargetType="ToggleButton" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2"
                                BorderBrush="Transparent" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- outlined text button ("New", "Edit in Paint") -->
        <Style x:Key="TextBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,0"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Fill" Value="#2EFFFFFF"/>
        </Style>

        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,8" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FA2C2C2C"/>
            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- accent slider -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="22" Height="22">
                            <Ellipse Fill="#454545" Stroke="#30FFFFFF" StrokeThickness="1"/>
                            <Ellipse Width="12" Height="12" Fill="{StaticResource Accent}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="24">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackFill}" Background="{StaticResource Accent}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackFill}" Background="#9A9A9A" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="IcoTextScan">M3,7 V4.5 C3,3.7 3.7,3 4.5,3 H7 M13,3 H15.5 C16.3,3 17,3.7 17,4.5 V7 M17,13 V15.5 C17,16.3 16.3,17 15.5,17 H13 M7,17 H4.5 C3.7,17 3,16.3 3,15.5 V13 M7,7.5 H13 M7,10 H13 M7,12.5 H11</Geometry>
        <Geometry x:Key="IcoShapes">M3,8.5 H10.5 V16 H3 Z M14,2.8 A4.2,4.2 0 1 1 13.99,2.8 Z</Geometry>
        <Geometry x:Key="IcoRectSnip">M4.5,4 H15.5 C16.3,4 17,4.7 17,5.5 V10.5 M10.5,16 H4.5 C3.7,16 3,15.3 3,14.5 V5.5 C3,4.7 3.7,4 4.5,4 M15,13 V18 M12.5,15.5 H17.5</Geometry>
        <Geometry x:Key="IcoNoDelay">M10,3.5 A6.5,6.5 0 1 1 9.99,3.5 Z M10,6.5 V10 L12.5,11.5 M3.5,3.5 L16.5,16.5</Geometry>
        <Geometry x:Key="IcoDelay">M10,3.5 A6.5,6.5 0 1 1 9.99,3.5 Z M10,6.5 V10 L12.5,11.5</Geometry>
        <Geometry x:Key="IcoCrop">M5.5,2.5 V14.5 H17.5 M2.5,5.5 H14.5 V17.5</Geometry>
    </Window.Resources>

    <DockPanel>
        <!-- ======================= toolbar ======================= -->
        <Grid DockPanel.Dock="Top" Height="52" Margin="12,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- left: New, photo/video, snip mode, delay -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnNew" Style="{StaticResource TextBtn}" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        ToolTip="New snip (Ctrl+N)" AutomationProperties.Name="New" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="New" FontSize="14" Margin="10,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Background="#0DFFFFFF" CornerRadius="6" Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BtnPhoto" Style="{StaticResource Seg}" Content="&#xE722;" ToolTip="Snip" IsChecked="True" Click="Photo_Click"/>
                        <ToggleButton x:Name="BtnVideo" Style="{StaticResource Seg}" Content="&#xE714;" ToolTip="Record" Click="Video_Click"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnMode" Style="{StaticResource Flat}" Width="56" ToolTip="Snipping mode" Click="Mode_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="ModeIcon" Width="20" Height="20"/>
                        <TextBlock Text="&#xE70D;" FontSize="9" Margin="6,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnDelay" Style="{StaticResource Flat}" Width="56" ToolTip="Snip delay" Click="Delay_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="DelayIcon" Data="{StaticResource IcoNoDelay}" Stroke="White" StrokeThickness="1.4" Width="20" Height="20"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <TextBlock Text="&#xE70D;" FontSize="9" Margin="6,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- centre: markup tools -->
            <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ToggleButton x:Name="ToolPen" Style="{StaticResource Tool}" ToolTip="Ballpoint pen" Click="Tool_Click">
                    <Canvas Width="20" Height="20">
                        <Path Data="M6,2.5 H14 L13,10 H7 Z" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        <Path x:Name="PenTip" Data="M7,10 H13 L10,17 Z" Fill="#E81123" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                    </Canvas>
                </ToggleButton>
                <ToggleButton x:Name="ToolHighlighter" Style="{StaticResource Tool}" ToolTip="Highlighter" Click="Tool_Click">
                    <Canvas Width="20" Height="20">
                        <Path x:Name="HlCap" Data="M5.5,2.5 H14.5 V7.5 H5.5 Z" Fill="#FCE100" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        <Path Data="M5.5,7.5 H14.5 L12.5,12 V16 L7.5,17.5 V12 Z" Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                    </Canvas>
                </ToggleButton>
                <ToggleButton x:Name="ToolEraser" Style="{StaticResource Tool}" ToolTip="Eraser" Click="Tool_Click">
                    <TextBlock Text="&#xE75C;"/>
                </ToggleButton>
                <ToggleButton x:Name="ToolShapes" Style="{StaticResource Tool}" ToolTip="Shapes" Click="Tool_Click">
                    <Path Data="{StaticResource IcoShapes}" Stroke="White" StrokeThickness="1.4" Width="20" Height="20"/>
                </ToggleButton>
                <Rectangle Style="{StaticResource Sep}"/>
                <ToggleButton x:Name="BtnCrop" Style="{StaticResource Tool}" ToolTip="Image crop" Click="Crop_Click">
                    <Path Data="{StaticResource IcoCrop}" Stroke="White" StrokeThickness="1.5" Width="20" Height="20"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </ToggleButton>
                <Button x:Name="BtnOcr" Style="{StaticResource Flat}" ToolTip="Text actions" Click="Ocr_Click">
                    <Path Data="{StaticResource IcoTextScan}" Stroke="White" StrokeThickness="1.4" Width="20" Height="20"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Rectangle Style="{StaticResource Sep}"/>
                <Button x:Name="BtnUndo" Style="{StaticResource Flat}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click"/>
                <Button x:Name="BtnRedo" Style="{StaticResource Flat}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click"/>
            </StackPanel>

            <!-- centre while cropping: apply / cancel -->
            <StackPanel x:Name="CropPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Button Style="{StaticResource Flat}" Content="&#xE8FB;" ToolTip="Apply crop (Enter)" Click="CropApply_Click"/>
                <Button Style="{StaticResource Flat}" Content="&#xE711;" ToolTip="Cancel crop (Esc)" Click="CropCancel_Click"/>
            </StackPanel>

            <!-- right: save, copy, share, more -->
            <StackPanel x:Name="ActionsPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnSave" Style="{StaticResource Flat}" Content="&#xE74E;" ToolTip="Save as (Ctrl+S)" Click="Save_Click"/>
                <Button x:Name="BtnCopy" Style="{StaticResource Flat}" Content="&#xE8C8;" ToolTip="Copy (Ctrl+C)" Click="Copy_Click"/>
                <Button x:Name="BtnShare" Style="{StaticResource Flat}" Content="&#xE72D;" ToolTip="Share" Click="Share_Click"/>
                <Button x:Name="BtnMore" Style="{StaticResource Flat}" Content="&#xE712;" ToolTip="See more" Click="More_Click"/>
            </StackPanel>
        </Grid>

        <!-- ======================= canvas ======================= -->
        <Grid x:Name="Stage" Background="#202020" ClipToBounds="True">
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="#B8B8B8" FontSize="15" LineHeight="24">
                <Run Text="Press New or Ctrl+Shift+S to start a snip."/>
                <LineBreak/>
                <Run Text="Snips and recordings are saved automatically." Foreground="#8A8A8A" FontSize="13"/>
            </TextBlock>
            <Viewbox x:Name="Fit" Stretch="Uniform" StretchDirection="DownOnly" Margin="40,24,40,40">
                <Grid x:Name="Paper">
                    <Image x:Name="Img" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <InkCanvas x:Name="Ink" Background="Transparent" Cursor="Pen" ClipToBounds="True"/>
                    <Canvas x:Name="CropLayer" Visibility="Collapsed" Background="Transparent">
                        <Path x:Name="CropDim" Fill="#99000000" IsHitTestVisible="False"/>
                        <Rectangle x:Name="CropMove" Fill="#01000000" Cursor="SizeAll"/>
                        <Path x:Name="CropOutline" Stroke="White" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>
            </Viewbox>
            <Border x:Name="StatusPill" Background="#E6303030" CornerRadius="6" Padding="12,6" Margin="0,0,0,12"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="Status" Foreground="#E6E6E6" FontSize="12.5"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
