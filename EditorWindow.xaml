<Window x:Class="ScreenX.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="screenX" Width="960" Height="680" MinWidth="780" MinHeight="380"
        Background="#202020" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ToolBtn" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolRadio" TargetType="RadioButton" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="GroupName" Value="tool"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource ToolBtn}"/>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="GroupName" Value="color"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Width="24" Height="24" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" Stroke="#55FFFFFF" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#60CDFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2B2B2B" Padding="8,4" BorderBrush="#1A000000" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnOcr" Style="{StaticResource Action}" Content="&#xE8D2;" ToolTip="Ekstrak teks dari gambar ini" Click="Ocr_Click"/>
                    <Button Style="{StaticResource Action}" Content="&#xE8C8;" ToolTip="Salin (Ctrl+C)" Click="Copy_Click"/>
                    <Button Style="{StaticResource Action}" Content="&#xE74E;" ToolTip="Simpan sebagai (Ctrl+S)" Click="Save_Click"/>
                    <Button Style="{StaticResource Action}" Content="&#xE838;" ToolTip="Buka folder screenshot" Click="Folder_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="ToolPen" Style="{StaticResource ToolRadio}" Content="&#xE76D;" ToolTip="Pulpen" IsChecked="True" Checked="Tool_Changed"/>
                    <RadioButton x:Name="ToolHighlighter" Style="{StaticResource ToolRadio}" Content="&#xE7E6;" ToolTip="Highlighter" Checked="Tool_Changed"/>
                    <RadioButton x:Name="ToolEraser" Style="{StaticResource ToolRadio}" Content="&#xE75C;" ToolTip="Penghapus" Checked="Tool_Changed"/>
                    <Rectangle Width="1" Height="22" Margin="6,0" Fill="#40FFFFFF"/>
                    <RadioButton Style="{StaticResource Swatch}" Background="#FF3B30" IsChecked="True" Checked="Color_Changed"/>
                    <RadioButton Style="{StaticResource Swatch}" Background="#FFCC00" Checked="Color_Changed"/>
                    <RadioButton Style="{StaticResource Swatch}" Background="#34C759" Checked="Color_Changed"/>
                    <RadioButton Style="{StaticResource Swatch}" Background="#0A84FF" Checked="Color_Changed"/>
                    <RadioButton Style="{StaticResource Swatch}" Background="#FFFFFF" Checked="Color_Changed"/>
                    <RadioButton Style="{StaticResource Swatch}" Background="#000000" Checked="Color_Changed"/>
                    <Slider x:Name="SizeSlider" Width="90" Minimum="1" Maximum="30" Value="3" VerticalAlignment="Center"
                            Margin="8,0" ToolTip="Ukuran" ValueChanged="Size_Changed"/>
                    <Rectangle Width="1" Height="22" Margin="6,0" Fill="#40FFFFFF"/>
                    <Button Style="{StaticResource Action}" Content="&#xE7A7;" ToolTip="Urungkan (Ctrl+Z)" Click="Undo_Click"/>
                    <Button Style="{StaticResource Action}" Content="&#xE74D;" ToolTip="Hapus semua coretan" Click="Clear_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#2B2B2B" Padding="12,4">
            <TextBlock x:Name="Status" Foreground="#B0B0B0" FontSize="12"/>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1A1A1A">
            <Grid x:Name="Board" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Grid.Effect>
                <Grid x:Name="Paper">
                    <Image x:Name="Img" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <InkCanvas x:Name="Ink" Background="Transparent" Cursor="Pen"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
